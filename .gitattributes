# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicit lock for critical config files (Firebase rules, TS, TSX)
*.rules       text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.md          text eol=lf

# Binary assets
*.png         binary
*.jpg         binary
*.jpeg        binary
*.ico         binary
*.pdf         binary
*.woff        binary
*.woff2       binary
