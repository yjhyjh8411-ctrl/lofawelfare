rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.uid == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      // 신규 가입: 본인 doc만 생성 (필드 검증은 클라이언트 + 어드민 사후 검토로 위임).
      allow create: if isOwner(userId);
      // 업데이트: 관리자는 모든 필드 가능. 본인은 isAdmin / accountStatus 변경 불가.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'accountStatus'])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Applications collection
    match /applications/{appId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.user_id == request.auth.uid ||
        resource.data['applicant']['사번'] == get(/databases/$(database)/documents/users/$(request.auth.uid)).data['사번']
      );
      allow create: if isAuth();
      allow update, delete: if isAdmin() || resource.data.user_id == request.auth.uid;
    }

    // Form configs - read by all authenticated, write by admin only
    match /form_configs/{formId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Budget groups - read by authenticated, write by admin
    match /budget_groups/{groupId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Settings - read by all, write by admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regulations - read by authenticated, write by admin
    match /regulations/{regId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Settlements - read by authenticated, write by admin
    match /settlements/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Notices (게시판) - read by all authenticated, write by admin
    match /notices/{noticeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // FAQs - read by all authenticated, write by admin
    match /faqs/{faqId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Budgets (연간 예산) - read & write by admin only
    match /budgets/{year} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // MFA OTP 코드 — 클라이언트에서 직접 접근 금지. Functions(admin SDK) 만 사용.
    match /mfa_codes/{uid} {
      allow read, write: if false;
    }
  }
}
